program project1;

uses Unit1, Unit2, Classes;

var human: TArrayHuman;
    fl: TFileStream;
    fl1: TArrayStream;
begin
    human := TArrayHuman.Create;

    fl1 := TArrayStream.Create;
    human.loadTStream(fl1);

    fl := TFileStream.Create('1.txt', fmOpenRead);
    human.loadTStream(fl);
    //human.loadTReader(fl);
    fl.free;

    human.manualInputHuman;
    human.writeArrHuman('-----');

    human.saveTStream(fl1);

    fl := TFileStream.Create('1.txt', fmCreate);
    human.saveTStream(fl);
    //human.saveTWriter(fl);
    fl.free;
{
    readln;

    human.loadTStream(fl1);
    human.manualInputHuman;
    human.writeArrHuman('-----');
    human.saveTStream(fl1);
}
    human.free;
    fl1.free;
    //readln;
end.

